# Backend environment example
# Copy this file to .env and replace the placeholder values before running locally.
# Required values are needed for the app to start successfully.

# Required: Supabase project URL. Get this from your Supabase project settings > API.
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase anon or service-role key used by the backend.
# IMPORTANT: Keep this server-side only. Do not expose it to the browser.
SUPABASE_KEY=your-supabase-key

# Required: Groq API key used for LLM completions and semantic analysis.
GROQ_API_KEY=your-groq-api-key

# Required: Hugging Face API token used for cloud-based semantic embeddings.
HUGGINGFACE_API_KEY=hf_your_token_here

# Required: Comma-separated list of frontend origins allowed to access the API.
# Use explicit origins instead of '*' in real deployments.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Port used by the FastAPI server.
PORT=8000

# Optional: Runtime environment label for logs and debugging.
APP_ENV=development

# Optional: Logging verbosity. Typical values: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO