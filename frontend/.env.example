# Frontend environment example
# Copy this file to .env and replace the placeholder value before running locally.
# Required values are needed for the app to talk to the backend.

# Required: Base URL for the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Optional: App name shown in the browser/dev tools.
VITE_APP_NAME=Smart Library AI

# Optional: Enables debug output in development builds.
VITE_ENABLE_DEBUG=false
